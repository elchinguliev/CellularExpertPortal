# The IIS deployment serves compiled static assets. Do not publish source maps,
# which can expose source-only development fixtures and implementation details.
GENERATE_SOURCEMAP=false

# The IIS application is mounted below the existing site, not at its root.
PUBLIC_URL=/ce_boss
REACT_APP_API_BASE=/ce_boss/api

# This deployment has no AI service. The portal's Node-backed documentation,
# authentication, administration, and ticket features remain available.
REACT_APP_AI_ENABLED=false
