NODE_ENV=production
PORT=4000

# Comma-separated browser origins allowed to send the session cookie.
CORS_ORIGINS=https://portal.example.internal

# Generate a unique random value of at least 32 characters. Use the same value
# in ai-backend/.env when the AI service is enabled.
JWT_SECRET=replace-with-a-unique-random-secret-at-least-32-characters

DB_HOST=replace-with-db-host
DB_PORT=5432
DB_NAME=replace-with-db-name
DB_USER=replace-with-db-user
DB_PASSWORD=replace-with-db-password
DB_SCHEMA=ce_boss

GITHUB_RAW_BASE=https://raw.githubusercontent.com/your-org/your-docs-repo/main
EMAIL_USER=replace-with-smtp-user
EMAIL_PASS=replace-with-smtp-password
SUPPORT_INBOX=support@example.internal
